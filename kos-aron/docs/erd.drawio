        <mxCell id="t_users" value="users&#10;----------------------------&#10;PK  id&#10;UQ  username&#10;    password_hash&#10;    role (admin|penghuni)&#10;    nama&#10;    status (aktif|nonaktif)&#10;    last_login_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
